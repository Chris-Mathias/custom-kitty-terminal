#!/usr/bin/env bash
# ct [-a] [folder] [-- claude arguments]
# Opens a new Claude Code session (with the side panel).
#   ct                     -> in a new tab, in the current folder
#   ct ~/Documents/Projects/my_project
#   ct -a [folder]         -> in the SAME tab, stacked: switch with the side panel
#   ct . -- --continue     -> passes --continue to claude
# Inside kitty it uses kitty tabs/windows; inside tmux, tmux windows;
# outside both, it opens a kitty window.
#   ct config              -> settings menu (language, theme, font, font size)

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/ckt.sh"

case ${1:-} in
  -h|--help) ckt_t cli.ct_help; echo; exit 0 ;;
  config)
    shift
    menu="$HOME/.local/bin/ct-config"
    # Inside kitty: as an overlay on the current window; elsewhere: right here.
    if [[ -n ${KITTY_WINDOW_ID:-} ]] && command -v kitten >/dev/null; then
      exec kitten @ launch --type=overlay --title="$(ckt_t menu.title)" "$menu" "$@" >/dev/null
    fi
    exec "$menu" "$@" ;;
esac

same_tab=0
if [[ ${1:-} == "-a" || ${1:-} == "--here" ]]; then same_tab=1; shift; fi

dir="${1:-$PWD}"
[[ $dir == "--" ]] && dir="$PWD"
[[ $# -gt 0 && $1 != "--" ]] && shift
[[ ${1:-} == "--" ]] && shift
dir=$(realpath "$dir") || exit 1

runner="$HOME/.local/bin/claude-panel"
sh_bin=${SHELL:-/usr/bin/zsh}

if [[ -n ${KITTY_WINDOW_ID:-} ]] && command -v kitten >/dev/null; then
  if (( same_tab )); then
    # Stack: one session at a time filling the whole tab
    kitten @ goto-layout stack >/dev/null 2>&1
    exec kitten @ launch --type=window --cwd="$dir" "$sh_bin" -ic "$(printf '%q ' "$runner" "$@")" >/dev/null
  fi
  exec kitten @ launch --type=tab --cwd="$dir" "$sh_bin" -ic "$(printf '%q ' "$runner" "$@")" >/dev/null
fi

if [[ -n ${TMUX:-} ]]; then
  exec tmux new-window -c "$dir" "$(printf '%q ' "$runner" "$@")"
fi

if command -v kitty >/dev/null; then
  # --session=none: just this window, without reopening the saved tabs
  kitty --single-instance --session=none --directory "$dir" "$sh_bin" -ic "$(printf '%q ' "$runner" "$@")" >/dev/null 2>&1 &
  disown
  exit 0
fi

ckt_t cli.open_in_kitty_or_tmux >&2; echo >&2
exit 1
