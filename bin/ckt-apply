#!/usr/bin/env python3
"""ckt-apply [--no-reload]: applies ~/.config/custom-kitty-terminal/settings.json
to kitty (theme and font) and Claude Code (theme, output style, spinner verbs)."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

import ckt  # noqa: E402

problems = ckt.apply(reload="--no-reload" not in sys.argv[1:])
for p in problems:
    print(p, file=sys.stderr)
sys.exit(1 if problems else 0)
