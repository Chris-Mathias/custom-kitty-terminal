#!/usr/bin/env bash
# claude-painel [argumentos do claude]
# Roda o Claude Code com o painel lateral (mod painel-sessao) e, quando ele
# terminar, deixa o zsh aberto no mesmo lugar. Usado pelo `ct` e pelos atalhos
# do kitty (Ctrl+Alt+N / Ctrl+Alt+T).

# Painel lateral (mod painel-sessao), instalado pelo install.sh.
# Pode ser trocado com a variável CLAUDE_PAINEL_DIR.
PAINEL="${CLAUDE_PAINEL_DIR:-$HOME/.local/share/claude-mods/painel-sessao}"

claude_bin=$(command -v claude || echo "$HOME/.local/bin/claude")
args=()
[[ -d $PAINEL ]] && args+=(--plugin-dir "$PAINEL")

"$claude_bin" "${args[@]}" "$@"
exec "${SHELL:-/usr/bin/zsh}"
